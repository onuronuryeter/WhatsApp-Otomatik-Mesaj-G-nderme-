{
  "name": "whatsapp-otomatik-mesaj-botu",
  "version": "1.1.7",
  "description": "WhatsApp Business Otomatik Mesaj Botu - Profesyonel Kampanya Yönetimi",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "server": "node server.js",
    "build": "electron-builder"
  },
  "dependencies": {
    "@juzi/whatsapp-web.js": "^1.30.37",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "qrcode": "^1.5.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^29.1.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.whatsapp.bot",
    "productName": "WhatsApp Mesaj Botu",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!data",
      "!.git",
      "!.wwebjs_auth"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "**/node_modules/puppeteer/**/*",
      "**/node_modules/puppeteer-core/**/*",
      "**/node_modules/puppeteer-extra/**/*",
      "**/node_modules/puppeteer-extra-plugin-*/**/*",
      "**/node_modules/@juzi/**/*"
    ]
  },
  "allowScripts": {
    "electron@29.4.6": true,
    "puppeteer@24.38.0": true
  }
}
